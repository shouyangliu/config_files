#!/bin/sh

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN_DIR="$HOME/.local/bin"

echo "Installing dwmblocks..."

cd "$SCRIPT_DIR"

make clean 2>/dev/null

make

if [ $? -ne 0 ]; then
    echo "Build failed!"
    exit 1
fi

mkdir -p "$BIN_DIR"
ln -sf "$SCRIPT_DIR/dwmblocks" "$BIN_DIR/dwmblocks"

echo "dwmblocks installed to $BIN_DIR/dwmblocks"
echo "Add this to your PATH: export PATH=\"$BIN_DIR:\$PATH\""