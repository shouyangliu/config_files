# sway config - shortcuts match dwm

exec dunst
exec picom
exec udiskie -a
exec nm-applet

# Variables
set $mod Mod4
set $term wezterm
set $menu rofi -show drun

# Output config
output DP-1 resolution 1920x1080@144

# Input config
input type:keyboard {
    xkb_options caps:escape
}

# Key bindings (matching dwm)
bindsym $mod+Return exec $term
bindsym $mod+b exec dmenu_run
bindsym $mod+p exec rofi -show drun
bindsym $mod+q exec flameshot gui
bindsym $mod+w exec feh --randomize --bg-fill ~/Downloads/wallpaper/

# Window focus (j/k like dwm)
bindsym $mod+j focus left
bindsym $mod+k focus right

# Master area (i/d like dwm - increase/decrease nmaster)
bindsym $mod+i exec echo "increase master"
bindsym $mod+d exec echo "decrease master"

# Mfact (h/l like dwm)
bindsym $mod+h resize shrink width 5px or 5ppt
bindsym $mod+l resize grow width 5px or 5ppt

# Layout
bindsym $mod+t layout toggle split
bindsym $mod+f floating toggle
bindsym $mod+m fullscreen toggle

bindsym $mod+Tab workspace next
bindsym $mod+Shift+Return exec swaymsg swap container with mark "old"

# Close
bindsym $mod+Shift+c kill

# Floating
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+f fullscreen toggle

# View all
bindsym $mod+0 workspace all

# Monitor
bindsym $mod+period focus output right
bindsym $mod+comma focus output left
bindsym $mod+Shift+period move container to output right
bindsym $mod+Shift+comma move container to output left

# Gaps
bindsym $mod+minus gaps inner current minus 5
bindsym $mod+equal gaps inner current plus 5
bindsym $mod+Shift+minus gaps inner current set 0
bindsym $mod+Shift+equal gaps inner current set 10

# Quit
bindsym $mod+Shift+e exit

# Tags 1-9
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

# Move to tag
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Toggle view/tag with control
bindsym $mod+Ctrl+1 workspace number 1; exec echo "toggle view"
bindsym $mod+Ctrl+2 workspace number 2; exec echo "toggle view"
bindsym $mod+Ctrl+3 workspace number 3; exec echo "toggle view"
bindsym $mod+Ctrl+4 workspace number 4; exec echo "toggle view"
bindsym $mod+Ctrl+5 workspace number 5; exec echo "toggle view"
bindsym $mod+Ctrl+6 workspace number 6; exec echo "toggle view"
bindsym $mod+Ctrl+7 workspace number 7; exec echo "toggle view"
bindsym $mod+Ctrl+8 workspace number 8; exec echo "toggle view"
bindsym $mod+Ctrl+9 workspace number 9; exec echo "toggle view"

bindsym $mod+Ctrl+Shift+1 move container to workspace number 1; exec echo "toggle tag"
bindsym $mod+Ctrl+Shift+2 move container to workspace number 2; exec echo "toggle tag"
bindsym $mod+Ctrl+Shift+3 move container to workspace number 3; exec echo "toggle tag"
bindsym $mod+Ctrl+Shift+4 move container to workspace number 4; exec echo "toggle tag"
bindsym $mod+Ctrl+Shift+5 move container to workspace number 5; exec echo "toggle tag"
bindsym $mod+Ctrl+Shift+6 move container to workspace number 6; exec echo "toggle tag"
bindsym $mod+Ctrl+Shift+7 move container to workspace number 7; exec echo "toggle tag"
bindsym $mod+Ctrl+Shift+8 move container to workspace number 8; exec echo "toggle tag"
bindsym $mod+Ctrl+Shift+9 move container to workspace number 9; exec echo "toggle tag"

# Mouse bindings
bindsym --whole-window $mod+button1 move
bindsym --whole-window $mod+button2 kill
bindsym --whole-window $mod+button3 resize

# Window rules
for_window [class="Gimp"] floating enable
for_window [class="Firefox"] move container to workspace number 9

# Border and gaps
default_border pixel 1
gaps inner 10

# Workspace names
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

# Bar
bar {
    swaybar_command waybar
}
